# .gitattributes

# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Source code
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Configuration files
*.toml text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
biome.json text eol=lf
tsconfig.json text eol=lf
package.json text eol=lf
package-lock.json text eol=lf
bun.lock binary
bunfig.toml text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
README.md text eol=lf

# Scripts
*.sh text eol=lf
*.bash text eol=lf

# Git
.gitignore text eol=lf
.gitattributes text eol=lf

# IDE settings
.editorconfig text eol=lf

# Project-specific files
*.ic10 text eol=lf
*.drawio text eol=lf
*.tree text eol=lf

# Images (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.webp binary

# Fonts (binary)
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary

# Archives (binary)
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Video (binary)
*.mp4 binary
*.mov binary
*.avi binary
*.webm binary

# Audio (binary)
*.mp3 binary
*.wav binary
*.ogg binary

# Documents (binary)
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary

# Executables
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Husky hooks - always LF
.husky/* text eol=lf

# Export (for git archive)
.gitattributes export-ignore
.gitignore export-ignore
.husky export-ignore
.vscode export-ignore
.idea export-ignore
tests export-ignore
tools export-ignore
*.test.ts export-ignore
*.test.js export-ignore
*.spec.ts export-ignore
*.spec.js export-ignore

# Linguist (for GitHub statistics)
tests/* linguist-vendored
*.test.ts linguist-vendored
*.spec.ts linguist-vendored
docs/* linguist-documentation
*.md linguist-documentation

# Diff settings
*.ts diff=typescript
*.js diff=javascript
*.json diff=json
*.md diff=markdown

# Merge strategies
package.json merge=union
package-lock.json merge=union
bun.lock merge=binary

# LFS (if you use large files)
# *.zip filter=lfs diff=lfs merge=lfs -text
# *.pdf filter=lfs diff=lfs merge=lfs -text